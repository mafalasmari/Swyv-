# Public site origin — used for canonical URLs, hreflang, sitemap and share images.
NEXT_PUBLIC_SITE_URL=https://swyv.sa

# Where a client lands after signing in at /[lang]/login.
# Leave empty for https://swyv.netlify.app/#overview.
NEXT_PUBLIC_PORTAL_URL=

# Client login (mobile number + SMS code). Without SMS_PROVIDER the login runs in
# demo mode: no SMS is sent and the code is shown on screen. Set both before launch.
AUTH_SECRET=            # long random string, e.g. `openssl rand -base64 32`
SMS_PROVIDER=           # unifonic | twilio
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Form delivery via Resend (https://resend.com). Without these, submissions are only logged.
RESEND_API_KEY=
FORMS_INBOX=
FORMS_FROM="SWYV <forms@your-verified-domain>"
