# Public site origin — used for canonical URLs, hreflang, sitemap and share images.
NEXT_PUBLIC_SITE_URL=https://swyv.sa

# Optional: where "Client login" points once the live portal has its own domain.
# Leave empty to open /[lang]/portal on this site.
NEXT_PUBLIC_PORTAL_URL=

# Form delivery via Resend (https://resend.com). Without these, submissions are only logged.
RESEND_API_KEY=
FORMS_INBOX=
FORMS_FROM="SWYV <forms@your-verified-domain>"
